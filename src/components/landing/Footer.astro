---
const nav = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#kegiatan', label: 'Kegiatan' },
  { href: '#pengurus', label: 'Pengurus' },
  { href: '#faq', label: 'FAQ' },
];
---

<div class="relative">
  <div
    class="pointer-events-none absolute -top-[15vw] left-0 right-0 z-10 flex items-end justify-center overflow-visible"
    aria-hidden="true"
  >
    <h2 class="whitespace-nowrap text-center text-[28vw] font-bold leading-[0.85] tracking-tighter text-zinc-200 sm:text-[25vw] md:text-[22vw] lg:text-[20vw]">
      CS7-SC
    </h2>
  </div>

  <footer id="contact" class="relative z-20 border-t border-border bg-background px-6 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div>
          <a href="#top" class="mb-4 flex items-center gap-2">
            <svg
              class="h-5 w-5 text-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M22 10 12 5 2 10v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2z"></path>
              <path d="M6 22V10"></path>
              <path d="M18 22V10"></path>
              <path d="M10 22v-4h4v4"></path>
            </svg>
            <span class="text-base font-medium text-foreground">CS7-SC</span>
          </a>
          <p class="mb-2 text-sm text-muted-foreground">Website resmi kelas CS7-SC.</p>
          <p class="text-sm text-muted-foreground">Info kegiatan, pengurus, dan pengumuman.</p>
        </div>

        <nav aria-label="Navigasi footer">
          <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-foreground">Jelajah</h3>
          <ul class="space-y-3">
            {nav.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div>
          <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-foreground">Kontak</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Urusan kelas melalui pengurus kelas atau wali kelas pada jam sekolah.
          </p>
        </div>
      </div>

      <div class="flex flex-col items-center justify-between gap-4 border-t border-border pt-8 md:flex-row">
        <p class="text-xs text-muted-foreground">© 2026 Kelas CS7-SC. Hak cipta dilindungi.</p>
        <p class="text-xs text-muted-foreground">Dikelola pengurus kelas bersama wali kelas.</p>
      </div>
    </div>
  </footer>
</div>
