---
// Footer ramping: hanya link yang punya tujuan nyata (anchor sections).
// Link mati template (About/Careers/sosial tanpa URL) dibuang per R-24/R-26.
const nav = [
  { href: '#how-it-works', label: 'Mission' },
  { href: '#features', label: 'Features' },
  { href: '#pricing', label: 'Properties' },
  { href: '#testimonials', label: 'Reviews' },
  { href: '#faq', label: 'FAQ' },
];
---

<div class="relative">
  <div
    class="absolute -top-[20vw] left-0 right-0 z-0 h-[50vw] w-full overflow-hidden"
    aria-hidden="true"
  >
    <img src="/images/footer-bg.png" alt="" class="h-full w-full object-cover" loading="lazy" />
  </div>

  <div
    class="pointer-events-none absolute -top-[15vw] left-0 right-0 z-10 flex items-end justify-center overflow-visible"
    aria-hidden="true"
  >
    <h2 class="whitespace-nowrap text-center text-[28vw] font-bold leading-[0.85] tracking-tighter text-white sm:text-[25vw] md:text-[22vw] lg:text-[20vw]">
      HOMIE
    </h2>
  </div>

  <footer id="contact" class="relative z-20 border-t border-border bg-background px-6 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div>
          <a href="#top" class="mb-4 flex items-center gap-2">
            <svg
              class="h-5 w-5 text-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span class="text-base font-medium text-foreground">Homie</span>
          </a>
          <p class="mb-2 text-sm text-muted-foreground">Peer-to-peer rentals, simplified.</p>
          <p class="text-sm text-muted-foreground">List a property via the button above.</p>
        </div>

        <nav aria-label="Navigasi footer">
          <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-foreground">Explore</h3>
          <ul class="space-y-3">
            {nav.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div>
          <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-foreground">Contact</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Questions about a listing? Reach the team through the support channel on your booking
            confirmation.
          </p>
        </div>
      </div>

      <div class="flex flex-col items-center justify-between gap-4 border-t border-border pt-8 md:flex-row">
        <p class="text-xs text-muted-foreground">© 2026 Homie. All rights reserved.</p>
        <p class="text-xs text-muted-foreground">Homie Inc. - Registered real estate agent</p>
      </div>
    </div>
  </footer>
</div>
