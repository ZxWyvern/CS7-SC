---
---

<section class="relative overflow-hidden px-6 py-32">
  <div
    class="pointer-events-none absolute inset-0 flex select-none items-center justify-center"
    aria-hidden="true"
  >
    <span class="whitespace-nowrap text-[20vw] font-bold font-sans leading-none tracking-tighter text-zinc-100">
      GABUNG
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="reveal mb-16 text-center">
      <h2 class="mx-auto mb-6 max-w-4xl font-serif text-4xl font-normal leading-tight md:text-5xl">
        Punya ide untuk kelas?
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-muted-foreground">
        Kelas ini jalan karena muridnya aktif. Sampaikan idemu, ikut kegiatannya.
      </p>

      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="#kegiatan"
          class="group relative flex items-center justify-center gap-0 overflow-hidden rounded-full bg-foreground py-1.5 pl-6 pr-1.5 text-background transition-all duration-300"
        >
          <span class="pr-4 text-sm">Lihat Kegiatan</span>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-background">
            <svg
              class="h-4 w-4 text-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </span>
        </a>

        <a
          href="#contact"
          class="group relative flex items-center justify-center gap-0 overflow-hidden rounded-full border border-border py-1.5 pl-6 pr-1.5 transition-all duration-300"
        >
          <span class="absolute inset-0 origin-right scale-x-0 rounded-full bg-foreground transition-transform duration-300 group-hover:scale-x-100"></span>
          <span class="relative z-10 pr-4 text-sm text-foreground transition-colors duration-300 group-hover:text-background">
            Hubungi Pengurus
          </span>
          <span class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full">
            <svg
              class="h-4 w-4 text-foreground transition-colors duration-300 group-hover:text-background"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
