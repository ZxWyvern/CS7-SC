---
// Nama asli menyusul dari pengurus kelas. Tanda [..] = placeholder, bukan data.
const officers = [
  { role: 'Ketua Kelas', name: '[Nama]', job: 'Koordinasi dan penanggung jawab kelas' },
  { role: 'Wakil Ketua', name: '[Nama]', job: 'Mendampingi ketua dan koordinator seksi' },
  { role: 'Sekretaris', name: '[Nama]', job: 'Absensi, surat, dan arsip kelas' },
  { role: 'Bendahara', name: '[Nama]', job: 'Kas kelas dan laporan keuangan' },
];
const points = [
  'Rapat kelas rutin',
  'Jadwal piket bergilir',
  'Kas tercatat terbuka',
  'Koordinator tiap seksi',
  'Info diumumkan terbuka',
  'Siap bantu wali kelas',
];
---

<section id="pengurus" class="relative overflow-hidden px-6 py-32">
  <div
    class="pointer-events-none absolute left-0 right-0 top-1/2 z-0 flex -translate-y-1/2 justify-center"
    aria-hidden="true"
  >
    <span class="whitespace-nowrap text-center text-[20vw] font-bold leading-none tracking-tighter text-zinc-100 sm:text-[18vw] md:text-[16vw] lg:text-[14vw]">
      KELAS
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div class="reveal order-2 lg:order-1">
        <div
          class="w-full rounded-2xl bg-white p-6"
          style="box-shadow: rgba(14,63,126,0.04) 0 0 0 1px, rgba(42,51,69,0.04) 0 1px 1px -0.5px, rgba(42,51,70,0.04) 0 6px 6px -3px, rgba(14,63,126,0.04) 0 24px 24px -12px;"
        >
          <div class="mb-6 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-slate-900">Pengurus Inti</h3>
            <span class="text-sm text-slate-500">Periode berjalan</span>
          </div>
          <div class="space-y-2">
            {officers.map((o) => (
              <div class="flex items-center justify-between gap-4 rounded-lg bg-slate-50 px-4 py-3">
                <div>
                  <p class="text-sm font-semibold text-slate-900">{o.role}</p>
                  <p class="text-xs text-slate-500">{o.job}</p>
                </div>
                <span class="text-sm font-medium text-slate-700">{o.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="order-1 space-y-8 lg:order-2">
        <div class="reveal">
          <h2 class="mb-6 font-serif text-4xl font-normal text-balance md:text-5xl">
            Dikelola murid, untuk murid
          </h2>
          <p class="text-lg leading-relaxed text-muted-foreground">
            Pengurus kelas memastikan kegiatan jalan, informasi sampai, dan tidak ada urusan yang
            menggantung.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {points.map((p) => (
            <div class="reveal flex items-center gap-2 rounded-xl px-3 py-1 transition-colors duration-300 hover:bg-zinc-50">
              <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 shadow-md">
                <svg
                  class="h-3.5 w-3.5 text-white"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
              </div>
              <span class="text-sm text-foreground">{p}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
