---
---

<section class="relative flex min-h-screen items-center overflow-hidden px-6 pb-12 pt-32">
  <div
    class="pointer-events-none absolute bottom-0 left-0 right-0 z-0 flex w-full items-end justify-center overflow-hidden"
    aria-hidden="true"
  >
    <span class="block text-center text-[22vw] font-bold leading-none tracking-tighter text-zinc-100 select-none sm:text-[20vw] md:text-[18vw] lg:text-[16vw]">
      CS7-SC
    </span>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl">
    <div class="mb-12 text-center">
      <h1
        id="hero-title"
        class="mx-auto mb-6 w-full max-w-6xl px-4 text-center font-serif text-6xl font-bold leading-[0.9] tracking-tighter text-black lg:text-9xl"
      >
        Satu Kelas, Satu Cerita
      </h1>
      <p class="mx-auto max-w-2xl leading-relaxed text-muted-foreground">
        Website resmi kelas CS7-SC. Info kegiatan, pengurus, dan pengumuman, semua di satu tempat.
      </p>
    </div>
  </div>
</section>

<style is:global>
  #hero-title .ch {
    display: inline-block;
    opacity: 0;
    filter: blur(12px);
    transform: translateY(30px);
    animation: hero-in 0.6s ease forwards;
  }
  #hero-title .wd {
    display: inline-block;
    white-space: nowrap;
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #hero-title .ch {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Split headline jadi huruf + animasi blur masuk (progresif: tanpa JS tetap tampil)
  const title = document.getElementById('hero-title');
  if (title && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = (title.textContent ?? '').trim().split(/\s+/);
    title.textContent = '';
    let i = 0;
    words.forEach((word, wi) => {
      const w = document.createElement('span');
      w.className = 'wd';
      if (wi < words.length - 1) w.style.marginRight = '0.25em';
      for (const ch of word) {
        const s = document.createElement('span');
        s.className = 'ch';
        s.style.animationDelay = `${0.3 + i * 0.04}s`;
        s.textContent = ch;
        w.appendChild(s);
        i++;
      }
      title.appendChild(w);
    });
  }
</script>
