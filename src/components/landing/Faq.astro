---
const faqs = [
  {
    q: 'Bagaimana cara ikut kegiatan kelas?',
    a: 'Datang sesuai jadwal yang ditempel di papan kelas. Kalau ragu, tanya langsung ke pengurus atau koordinator kegiatan.',
  },
  {
    q: 'Ke siapa lapor kalau berhalangan piket?',
    a: 'Kabari ketua kelas sebelumnya, lalu tukar jadwal dengan teman. Jangan biarkan piket kosong tanpa kabar.',
  },
  {
    q: 'Bagaimana iuran kas dikelola?',
    a: 'Dicatat bendahara dan dilaporkan tiap rapat kelas. Semua murid boleh melihat catatannya.',
  },
  {
    q: 'Bolehkah mengusulkan kegiatan baru?',
    a: 'Boleh. Sampaikan di rapat kelas atau langsung ke pengurus, nanti dibahas bersama.',
  },
  {
    q: 'Di mana info resmi kelas diumumkan?',
    a: 'Papan pengumuman di ruang kelas dan grup resmi. Info di luar itu belum tentu benar.',
  },
  {
    q: 'Bagaimana menghubungi wali kelas?',
    a: 'Melalui ketua kelas, atau temui langsung di ruang guru pada jam istirahat.',
  },
];
---

<section id="faq" class="px-6 py-32 pb-80">
  <div class="mx-auto max-w-4xl">
    <div class="reveal mb-16 text-center">
      <h2 class="mb-6 font-serif text-4xl font-normal text-balance md:text-5xl">
        Sering ditanyakan
      </h2>
      <p class="mx-auto max-w-2xl leading-relaxed text-muted-foreground">
        Hal yang paling sering ditanyakan murid baru soal kelas ini.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="reveal group rounded-xl border border-border bg-card px-6 open:border-foreground/30">
          <summary class="cursor-pointer list-none py-5 text-base font-medium text-foreground [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {f.q}
              <svg
                class="h-4 w-4 flex-shrink-0 transition-transform duration-300 group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </span>
          </summary>
          <p class="pb-5 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
