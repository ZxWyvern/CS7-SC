---
// Angka asli menyusul dari pengurus kelas. Tanda [..] = placeholder, bukan data.
const stats = [
  { value: '[XX]', label: 'Murid' },
  { value: '[XX]', label: 'Pengurus Inti' },
  { value: '[XXXX]', label: 'Angkatan' },
];
---

<section id="stats-section" class="bg-background px-6 py-24">
  <div class="mx-auto max-w-4xl">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3 lg:gap-16">
      {stats.map((s, i) => (
        <div class="reveal text-center" style={`transition-delay:${200 + i * 100}ms`}>
          <p class="mb-2 text-6xl font-light leading-none text-foreground md:text-7xl">{s.value}</p>
          <p class="text-xs uppercase tracking-wider text-muted-foreground">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
