---
const services = [
  {
    title: 'Detailed listings',
    description: 'HD photos, 360° virtual tours, and complete descriptions for every property.',
    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  },
  {
    title: 'Key management',
    description: 'Secure key handover system and real-time check-in/check-out tracking.',
    icon: '<path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/>',
  },
  {
    title: 'Secure payments',
    description: 'Protected transactions with tenant guarantee and damage insurance included.',
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  },
];
---

<section id="how-it-works" class="relative overflow-hidden px-6 py-32 pb-24">
  <div
    class="pointer-events-none absolute left-0 right-0 top-0 z-0 flex justify-center"
    aria-hidden="true"
  >
    <span class="whitespace-nowrap text-center text-[18vw] font-bold leading-none tracking-tighter text-zinc-100 sm:text-[16vw] md:text-[14vw] lg:text-[12vw]">
      MISSION
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="reveal relative mb-32 overflow-hidden rounded-3xl px-6 py-16 lg:px-8 lg:py-10">
      <div class="absolute inset-0 h-full w-full">
        <img
          src="/images/7aecbceb-cbd3-4cbd-901c-dd0125d41525.png"
          alt="Beautiful house"
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="hidden lg:block" aria-hidden="true"></div>
        <div class="order-1 lg:order-2">
          <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-white/80">
            Our mission
          </p>
          <h2 class="mb-8 font-sans text-5xl font-medium text-balance text-white md:text-4xl lg:text-5xl">
            Simplifying peer-to-peer rentals
          </h2>
          <div class="space-y-6 leading-relaxed text-white/90">
            <p>
              At Homie, we believe renting a home should be as simple as booking a restaurant. Our
              platform connects owners and tenants directly, with no agency fees.
            </p>
            <p>
              Every listing is verified, every transaction secured. We have reimagined the rental
              experience to make it transparent, fast, and human.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal mb-20 text-center">
      <h2 class="mb-6 font-serif text-4xl font-normal text-balance md:text-5xl">
        Everything you need
      </h2>
      <p class="mx-auto max-w-2xl leading-relaxed text-muted-foreground">
        A complete platform to manage your rentals from A to Z, whether you are an owner or a
        tenant.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {services.map((s) => (
        <div class="reveal rounded-3xl p-8 text-center transition-colors duration-300 hover:bg-zinc-50">
          <div class="mb-6 flex justify-center">
            <svg
              class="h-16 w-16 text-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              aria-hidden="true"
              set:html={s.icon}
            />
          </div>
          <h3 class="mb-3 text-xl font-medium text-foreground">{s.title}</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
