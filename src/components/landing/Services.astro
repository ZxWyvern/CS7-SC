---
const values = [
  {
    title: 'Belajar Bersama',
    description: 'Diskusi pelajaran, tugas kelompok, dan saling bantu sebelum ulangan.',
    icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  },
  {
    title: 'Tertib dan Rapi',
    description: 'Jadwal piket bergilir, absensi tercatat, dan kas kelas transparan.',
    icon: '<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>',
  },
  {
    title: 'Kekeluargaan',
    description: 'Gotong royong, perayaan bersama, dan tidak ada yang tertinggal.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  },
];
---

<section id="tentang" class="relative overflow-hidden px-6 py-32 pb-24">
  <div
    class="pointer-events-none absolute left-0 right-0 top-0 z-0 flex justify-center"
    aria-hidden="true"
  >
    <span class="whitespace-nowrap text-center text-[18vw] font-bold leading-none tracking-tighter text-zinc-100 sm:text-[16vw] md:text-[14vw] lg:text-[12vw]">
      TENTANG
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="reveal relative mb-32 overflow-hidden rounded-3xl bg-zinc-900 px-6 py-16 lg:px-12 lg:py-14">
      <div class="relative z-10 max-w-3xl">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-white/70">
          Tentang kami
        </p>
        <h2 class="mb-8 font-sans text-4xl font-medium text-balance text-white md:text-5xl">
          Kelas yang solid, murid yang aktif
        </h2>
        <div class="space-y-6 leading-relaxed text-white/80">
          <p>
            Kami murid kelas CS7-SC. Website ini jadi papan info bersama: jadwal, kegiatan, dan
            pengumuman, supaya tidak ada yang ketinggalan kabar.
          </p>
          <p>
            Dikelola pengurus kelas bersama wali kelas. Ada usulan kegiatan? Sampaikan di rapat
            kelas atau hubungi pengurus.
          </p>
        </div>
      </div>
    </div>

    <div class="reveal mb-20 text-center">
      <h2 class="mb-6 font-serif text-4xl font-normal text-balance md:text-5xl">Yang kami jaga</h2>
      <p class="mx-auto max-w-2xl leading-relaxed text-muted-foreground">
        Tiga hal yang membuat kelas ini berjalan rapi dari hari ke hari.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {values.map((s) => (
        <div class="reveal rounded-3xl p-8 text-center transition-colors duration-300 hover:bg-zinc-50">
          <div class="mb-6 flex justify-center">
            <svg
              class="h-16 w-16 text-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              aria-hidden="true"
              set:html={s.icon}
            />
          </div>
          <h3 class="mb-3 text-xl font-medium text-foreground">{s.title}</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
