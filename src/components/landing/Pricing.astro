---
// Jadwal asli menyusul dari pengurus kelas. Tanda [..] = placeholder, bukan data.
const activities = [
  {
    name: 'Kerja Bakti Kelas',
    schedule: '[Jadwal]',
    place: 'Ruang kelas',
    desc: 'Bersih-bersih dan rapikan ruang kelas bersama.',
    tags: ['Rutin', 'Semua murid', 'Gotong royong'],
  },
  {
    name: 'Belajar Kelompok',
    schedule: '[Jadwal]',
    place: 'Ruang kelas',
    desc: 'Diskusi pelajaran dan persiapan ulangan bersama.',
    tags: ['Rutin', 'Akademik', 'Diskusi'],
  },
  {
    name: 'Rapat Kelas',
    schedule: '[Jadwal]',
    place: 'Ruang kelas',
    desc: 'Evaluasi kas, piket, dan rencana kegiatan berikutnya.',
    tags: ['Rutin', 'Pengurus', 'Evaluasi'],
  },
  {
    name: 'Class Meeting',
    schedule: '[Jadwal]',
    place: 'Lapangan sekolah',
    desc: 'Lomba antar kelas setelah ujian semester.',
    tags: ['Semesteran', 'Olahraga', 'Lomba'],
  },
  {
    name: 'Bakti Sosial',
    schedule: '[Jadwal]',
    place: '[Lokasi]',
    desc: 'Kumpul dan salurkan bantuan untuk yang membutuhkan.',
    tags: ['Sosial', 'Donasi', 'Lapangan'],
  },
  {
    name: 'Perayaan Kelas',
    schedule: '[Jadwal]',
    place: 'Ruang kelas',
    desc: 'Syukuran kenaikan kelas dan perpisahan akhir tahun.',
    tags: ['Tahunan', 'Kebersamaan', 'Acara'],
  },
];
---

<section id="kegiatan" class="overflow-hidden py-32">
  <div class="reveal mx-auto mb-12 max-w-7xl px-6 text-center">
    <h2 class="mb-6 font-serif text-4xl font-normal text-balance md:text-5xl">Kegiatan Kami</h2>
    <p class="mx-auto max-w-2xl leading-relaxed text-muted-foreground">
      Agenda rutin kelas sepanjang semester. Jadwal pasti ditempel di papan kelas.
    </p>
  </div>

  <div class="reveal relative mx-auto max-w-7xl px-6">
    <div class="mb-4 flex justify-end gap-2">
      <button
        id="prop-prev"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:bg-zinc-100"
        aria-label="Kegiatan sebelumnya"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
      </button>
      <button
        id="prop-next"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:bg-zinc-100"
        aria-label="Kegiatan berikutnya"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>

    <div
      id="prop-track"
      class="flex snap-x gap-6 overflow-x-auto scroll-smooth pb-4"
      tabindex="0"
      role="region"
      aria-label="Daftar kegiatan kelas"
    >
      {activities.map((a) => (
        <article
          class="w-[85vw] flex-shrink-0 snap-start rounded-3xl bg-white p-6 sm:w-[60vw] lg:w-[400px]"
          style="box-shadow: rgba(14,63,126,0.04) 0 0 0 1px, rgba(42,51,70,0.04) 0 6px 6px -3px, rgba(14,63,126,0.04) 0 24px 24px -12px;"
        >
          <p class="mb-1 text-xs font-medium uppercase tracking-wider text-emerald-700">
            {a.schedule}
          </p>
          <h3 class="mb-2 text-2xl font-bold text-slate-900">{a.name}</h3>
          <p class="mb-4 text-sm text-slate-600">{a.place}</p>
          <p class="mb-4 text-sm leading-relaxed text-slate-600">{a.desc}</p>
          <div class="flex flex-wrap gap-2">
            {a.tags.map((t) => (
              <span class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('prop-track');
  const step = () => (track ? track.clientWidth * 0.8 : 0);
  document
    .getElementById('prop-prev')
    ?.addEventListener('click', () => track?.scrollBy({ left: -step() }));
  document
    .getElementById('prop-next')
    ?.addEventListener('click', () => track?.scrollBy({ left: step() }));
</script>
