---
import LandingLayout from '../layouts/LandingLayout.astro';
import Header from '../components/landing/Header.astro';
import Hero from '../components/landing/Hero.astro';
import Stats from '../components/landing/Stats.astro';
import Services from '../components/landing/Services.astro';
import Features from '../components/landing/Features.astro';
import Cta from '../components/landing/Cta.astro';
import Pricing from '../components/landing/Pricing.astro';
import Faq from '../components/landing/Faq.astro';
import Footer from '../components/landing/Footer.astro';
---

<LandingLayout>
  <div id="top">
    <Header />
    <main id="main">
      <Hero />
      <Stats />
      <Services />
      <Features />
      <Pricing />
      <Cta />
      <Faq />
    </main>
    <Footer />
  </div>
</LandingLayout>
